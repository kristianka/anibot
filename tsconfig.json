{
    "compilerOptions": {
        "outDir": "./dist",
        "allowJs": true,
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true
    },
    "include": ["./src/**/*"]
}
